# Optional: backend configuration file; no API keys are required for offline use.
HIRESENSE_CONFIG=resources/experiments/backend.json

# Speech is local by default after scripts/prepare_voice.py; no keys required.
SCHOLARGRAPH_STT_PROVIDER=vosk
SCHOLARGRAPH_TTS_PROVIDER=auto
# Optional local overrides; Compose uses models baked into its image.
# SCHOLARGRAPH_PIPER_MODEL=/absolute/path/to/en_US-ljspeech-medium.onnx
# SCHOLARGRAPH_VOSK_MODEL=/absolute/path/to/vosk-en
# Optional Gemini speech with automatic local fallback (uses GEMINI_API_KEY below):
# SCHOLARGRAPH_STT_PROVIDER=gemini
# SCHOLARGRAPH_TTS_PROVIDER=gemini
# SCHOLARGRAPH_GEMINI_STT_MODEL=gemini-2.5-flash
# SCHOLARGRAPH_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# SCHOLARGRAPH_GEMINI_TTS_VOICE=Kore
# Optional alternative remote speech: set either provider above to openai-compatible.
# Kept exclusively in the Python API environment, never NEXT_PUBLIC_*.
SCHOLARGRAPH_SPEECH_BASE_URL=https://api.openai.com/v1
SCHOLARGRAPH_SPEECH_API_KEY=
SCHOLARGRAPH_STT_MODEL=whisper-1
SCHOLARGRAPH_TTS_MODEL=tts-1
SCHOLARGRAPH_TTS_VOICE=alloy

# Independent conversation model. The small local GGUF is a basic fallback,
# not a substitute for a larger conversational model.
# Auto uses Gemini when GEMINI_API_KEY is present, with local fallback before
# any response is streamed. Without a key it uses the local model only.
SCHOLARGRAPH_CHAT_PROVIDER=auto
GEMINI_API_KEY=
SCHOLARGRAPH_GEMINI_MODEL=gemini-2.5-flash
# SCHOLARGRAPH_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SCHOLARGRAPH_CHAT_MODEL_PATH=data/models/query-understanding.gguf
# Alternative: run Ollama separately and set the provider to ollama.
SCHOLARGRAPH_CHAT_BASE_URL=http://127.0.0.1:11434
SCHOLARGRAPH_CHAT_MODEL=qwen2.5:0.5b
SCHOLARGRAPH_CHAT_API_KEY=
# OpenAI-compatible chat completions: set provider=openai-compatible and use
# the provider's /v1 base URL and model name, with its server-side API key.
